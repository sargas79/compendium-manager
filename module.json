{
  "id": "compendium-manager",
  "title": "Compendium Manager",
  "description": "Shares one compendium library between two Pathfinder 2e worlds on the same Foundry installation. Content saved in one world is available in the other after switching. Designed for installations where only one world runs at a time.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Diego Vescovini"
    }
  ],
  "url": "https://github.com/sargas79/compendium-manager",
  "manifest": "https://github.com/sargas79/compendium-manager/releases/latest/download/module.json",
  "download": "https://github.com/sargas79/compendium-manager/releases/download/v0.1.0/module.zip",
  "readme": "https://github.com/sargas79/compendium-manager/blob/main/README.md",
  "changelog": "https://github.com/sargas79/compendium-manager/blob/main/CHANGELOG.md",
  "license": "https://github.com/sargas79/compendium-manager/blob/main/LICENSE",
  "bugs": "https://github.com/sargas79/compendium-manager/issues",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {}
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/compendium-manager.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "cm-actors",
      "label": "Shared Actors",
      "path": "packs/cm-actors",
      "type": "Actor",
      "system": "pf2e",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cm-items",
      "label": "Shared Items",
      "path": "packs/cm-items",
      "type": "Item",
      "system": "pf2e",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cm-journals",
      "label": "Shared Journals",
      "path": "packs/cm-journals",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cm-tables",
      "label": "Shared Roll Tables",
      "path": "packs/cm-tables",
      "type": "RollTable",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cm-macros",
      "label": "Shared Macros",
      "path": "packs/cm-macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cm-scenes",
      "label": "Shared Scenes",
      "path": "packs/cm-scenes",
      "type": "Scene",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cm-cards",
      "label": "Shared Cards",
      "path": "packs/cm-cards",
      "type": "Cards",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    }
  ]
}
